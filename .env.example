# Server port
PORT=3000

# MongoDB connection string.
# For local (non-Docker) run: mongodb://localhost:27017/keyboard-trainer
# When using docker compose this value is overridden to
# mongodb://host.docker.internal:27017/keyboard-trainer (host MongoDB)
DB_URI=mongodb://localhost:27017/keyboard-trainer

# Admin authentication password
ADMIN_PASSWORD=admin123

# Secret used to sign admin JWT tokens (falls back to ADMIN_PASSWORD if empty)
JWT_SECRET=

# Server IP for local network access (shown in logs; must match the current Wi-Fi address)
NETWORK_IP=192.168.1.100

# Auto-seed texts on startup when the DB is connected and empty
AUTO_SEED=false

# Also create the demo student (alias "Тест", code "1234") during seeding
SEED_DEMO_USER=false
